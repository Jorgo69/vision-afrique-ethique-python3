# ============================================
# SECRETS DE SÉCURITÉ
# ============================================
# ⚠️ IMPORTANT : Changez ces valeurs en production !
# 
# VISION_SECRET_PART1 et VISION_SECRET_PART2 sont utilisés pour un double hashage
# des embeddings, garantissant que même si une clé est compromise, l'embedding
# chiffré reste inutilisable. 
#
# Comment générer des secrets forts :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Minimum 32 caractères requis.

VISION_SECRET_PART1=votre_chaine_aleatoire_tres_longue_ici_minimum_32_caracteres_et_plus
VISION_SECRET_PART2=une_autre_chaine_different_et_egalement_tres_longue_minimum_32_et_plus

# ============================================
# CONFIGURATION DU MODÈLE INSIGHTFACE
# ============================================
# buffalo_l : Modèle léger et performant (recommandé)
MODEL_NAME=buffalo_l

# -1 force l'utilisation du CPU (pas besoin de GPU pour démarrer)
MODEL_CONTEXT_ID=-1

# ============================================
# ENVIRONNEMENT
# ============================================
# development | production
ENVIRONMENT=development